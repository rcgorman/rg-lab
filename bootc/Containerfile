FROM quay.io/almalinuxorg/almalinux-bootc:10.2

# Netbird Repo
COPY files/yum.repos.d/netbird.repo /etc/yum.repos.d/netbird.repo

RUN dnf install -y \
        bash-completion \
        chrony \
        cloud-init \
        firewalld \
        git \
        netbird \
        nfs-utils \
        openscap-scanner \
        podman \
        python3 \
        python3-libselinux \
        qemu-guest-agent \
        rsync \
        scap-security-guide \
        sudo \
        vim-enhanced \
    && dnf clean all

# Disable cloud-init root filesystem resizing for bootc/composefs
RUN printf '%s\n' \
        'growpart:' \
        '  mode: "off"' \
        'resize_rootfs: false' \
        > /etc/cloud/cloud.cfg.d/99-bootc-disable-growpart.cfg

# Baseline users and Podman subuid/subgid mappings
RUN groupadd --system lab-admins ; \
    useradd --create-home --groups wheel --shell /bin/bash --comment "Ansible automation user" ansible ; \
    useradd --create-home --groups lab-admins --shell /bin/bash --comment "Ryan Gorman" ryan ; \
    passwd --lock ansible ; \
    passwd --lock ryan ; \
    chmod 0700 /home/ansible /home/ryan ; \
    install -d -m 0750 /etc/sudoers.d ; \
    printf 'ansible ALL=(ALL) NOPASSWD: ALL\n' > /etc/sudoers.d/ansible ; \
    printf '%%lab-admins ALL=(ALL) ALL\n' > /etc/sudoers.d/lab-admins ; \
    chmod 0440 /etc/sudoers.d/ansible ; \
    chmod 0440 /etc/sudoers.d/lab-admins ; \
    visudo --check --file=/etc/sudoers.d/ansible ; \
    visudo --check --file=/etc/sudoers.d/lab-admins ; \
    grep -q '^containers:' /etc/subuid || echo 'containers:2147483647:2147483648' >> /etc/subuid ; \
    grep -q '^containers:' /etc/subgid || echo 'containers:2147483647:2147483648' >> /etc/subgid

# CIS Level 1 Server hardening
RUN oscap xccdf eval --remediate \
        --profile xccdf_org.ssgproject.content_profile_cis_server_l1 \
        /usr/share/xml/scap/ssg/content/ssg-almalinux10-ds.xml ; \
    dnf remove -y openscap-scanner scap-security-guide \
    && dnf clean all

# Crypto policy
RUN update-crypto-policies --set DEFAULT

# SSH accepts keys only; human passwords are for console login and sudo
RUN install -d -m 0755 /etc/ssh/sshd_config.d \
    && printf '%s\n' \
        'PasswordAuthentication no' \
        'KbdInteractiveAuthentication no' \
        'PermitRootLogin no' \
        > /etc/ssh/sshd_config.d/20-rg-lab-auth.conf

# SELinux lockdown service
COPY files/kargs.d/01-selinux.toml /usr/lib/bootc/kargs.d/01-selinux.toml
COPY files/systemd/selinux-lockdown.service /usr/lib/systemd/system/selinux-lockdown.service

# Enable services
RUN systemctl enable \
        chronyd.service \
        firewalld.service \
        netbird.service \
        qemu-guest-agent.service \
        selinux-lockdown.service

RUN bootc container lint
