[Unit]
Description=Create {{ item | capitalize }} recovery backup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/bash {{ application_backup_libexec_dir }}/rg-backup-{{ item }}
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
