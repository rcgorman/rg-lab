#!/usr/bin/bash
set -Eeuo pipefail
umask 077

backup_root={{ application_backup_root | quote }}
retention_days={{ application_backup_retention_days | int }}
job_root="${backup_root}/immich"
timestamp=$(date --utc +%Y%m%dT%H%M%SZ)
final_dir="${job_root}/${timestamp}"
stage_dir=""

cleanup() {
  local status=$?
  trap - EXIT
  if [[ "${status}" -ne 0 && -n "${stage_dir}" ]]; then
    rm -rf -- "${stage_dir}"
  fi
  exit "${status}"
}
trap cleanup EXIT

exec 9>/run/lock/rg-backup-immich.lock
flock --nonblock 9

install -d -m 0700 "${job_root}"
stage_dir=$(mktemp --directory "${job_root}/.tmp.${timestamp}.XXXXXX")

podman exec immich_postgres \
  pg_dump --clean --if-exists --dbname=immich --username=postgres \
  | gzip --fast > "${stage_dir}/immich.sql.gz"
test -s "${stage_dir}/immich.sql.gz"
gzip --test "${stage_dir}/immich.sql.gz"

{
  printf 'created_utc=%s\n' "${timestamp}"
  printf 'host=%s\n' "$(hostname --short)"
  podman volume inspect immich-library \
    --format '{% raw %}volume={{.Name}} device={{index .Options "device"}}{% endraw %}'
  podman inspect immich_postgres --format '{% raw %}container={{.Name}} image={{.ImageName}} image_id={{.Image}}{% endraw %}'
  podman inspect immich_server --format '{% raw %}container={{.Name}} image={{.ImageName}} image_id={{.Image}}{% endraw %}'
} > "${stage_dir}/manifest.txt"

mv -- "${stage_dir}" "${final_dir}"
stage_dir=""
find "${job_root}" -mindepth 1 -maxdepth 1 -type d -mtime "+${retention_days}" -exec rm -rf -- {} +
