[Unit]
Description=Upload rg-lab recovery backups to Restic
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/bash {{ restic_client_libexec_dir }}/rg-restic-backup
UMask=0077
CacheDirectory=restic
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
