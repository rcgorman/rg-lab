#!/usr/bin/bash
set -Eeuo pipefail
umask 077

{% for job in application_backup_jobs | default([]) %}
systemctl start {{ ('rg-backup-' ~ job ~ '.service') | quote }}
{% endfor %}

backup_paths=(
{% for path in restic_client_backup_paths %}
  {{ path | quote }}
{% endfor %}
)

for path in "${backup_paths[@]}"; do
  if [[ ! -e "${path}" ]]; then
    echo "Restic backup source does not exist: ${path}" >&2
    exit 1
  fi
done

exec /usr/bin/bash {{ restic_client_libexec_dir | quote }}/rg-restic backup \
  --host {{ restic_client_host | quote }} \
{% for tag in restic_client_tags %}
  --tag {{ tag | quote }} \
{% endfor %}
  "${backup_paths[@]}"
