[Unit]
Description=Vaultwarden

[Container]
ContainerName=vaultwarden
Image={{ container_images.vaultwarden }}
UserNS=auto
Pull=newer
Network=vaultwarden.network
PublishPort=18080:80
Environment=TZ=America/New_York
Environment=DOMAIN=https://vault.internal.gormantech.com
Environment=SIGNUPS_ALLOWED={{ vaultwarden_signups_allowed | default(false) | bool | lower }}
Environment=INVITATION_ORG_NAME=GormanTech
Environment=WEBSOCKET_ENABLED=true
Environment=WEB_VAULT_ENABLED=true
Environment=SHOW_PASSWORD_HINT=false
Environment=LOG_LEVEL=info
Secret=vaultwarden_admin_token,type=env,target=ADMIN_TOKEN
Volume=vaultwarden-data.volume:/data:idmap

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
