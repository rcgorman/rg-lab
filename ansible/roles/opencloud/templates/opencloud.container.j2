[Unit]
Description=OpenCloud
Requires=onlyoffice.service
After=onlyoffice.service

[Container]
ContainerName=opencloud
Image={{ container_images.opencloud }}
User=3001:3001
Pull=newer
Network=opencloud.network
NetworkAlias=opencloud
DNS=10.6.13.1
PublishPort=9200:9200
Entrypoint=/bin/sh
Exec=-c "set -e; if [ ! -f /etc/opencloud/opencloud.yaml ]; then opencloud init; fi; exec opencloud server"
Environment=TZ=America/New_York
Environment=OC_URL=https://cloud.internal.gormantech.com
Environment=OC_LOG_LEVEL=info
Environment=OC_LOG_COLOR=false
Environment=OC_LOG_PRETTY=false
Environment=PROXY_TLS=false
Environment=PROXY_HTTP_ADDR=0.0.0.0:9200
Environment=OC_INSECURE=false
Environment=PROXY_ENABLE_BASIC_AUTH=false
Environment=IDM_CREATE_DEMO_USERS=false
Environment=FRONTEND_ARCHIVER_MAX_SIZE=10000000000
Environment=FRONTEND_CHECK_FOR_UPDATES=true
Environment=PROXY_CSP_CONFIG_FILE_LOCATION=/etc/opencloud/csp.yaml
Environment=OC_SHARING_PUBLIC_SHARE_MUST_HAVE_PASSWORD=true
Environment=OC_SHARING_PUBLIC_WRITEABLE_SHARE_MUST_HAVE_PASSWORD=false
Environment=OC_PASSWORD_POLICY_DISABLED=false
Environment=OC_PASSWORD_POLICY_MIN_CHARACTERS=8
Environment=OC_PASSWORD_POLICY_MIN_LOWERCASE_CHARACTERS=1
Environment=OC_PASSWORD_POLICY_MIN_UPPERCASE_CHARACTERS=1
Environment=OC_PASSWORD_POLICY_MIN_DIGITS=1
Environment=OC_PASSWORD_POLICY_MIN_SPECIAL_CHARACTERS=1
Environment=OC_DEFAULT_LANGUAGE=en
Environment=OC_ADD_RUN_SERVICES=collaboration
Environment=FRONTEND_APP_HANDLER_SECURE_VIEW_APP_ADDR=eu.opencloud.api.collaboration
Environment=GRAPH_AVAILABLE_ROLES=b1e2218d-eef8-4d4c-b82d-0f1a1b48f3b5,a8d5fe5e-96e3-418d-825b-534dbdf22b99,fb6c3e19-e378-47e5-b277-9732f9de6e21,58c63c02-1d89-4572-916a-870abc5a1b7d,2d00ce52-1fc2-4dbc-8b95-a73b73395f5a,1c996275-f1c9-4e71-abdf-a42f6495e960,312c0871-5ef7-4b3a-85b6-0e4074c64049,aa97fe03-7980-45ac-9e50-b325749fd7e6
Environment=COLLABORATION_WOPI_SRC=https://cloud.internal.gormantech.com
Environment=COLLABORATION_APP_NAME=OnlyOffice
Environment=COLLABORATION_APP_PRODUCT=OnlyOffice
Environment=COLLABORATION_APP_ADDR=https://office.internal.gormantech.com
Environment=COLLABORATION_APP_ICON=https://office.internal.gormantech.com/web-apps/apps/documenteditor/main/resources/img/favicon.ico
Environment=COLLABORATION_APP_INSECURE=false
Environment=COLLABORATION_CS3API_DATAGATEWAY_INSECURE=false
Environment=COLLABORATION_APP_PROOF_DISABLE=true
Secret=opencloud_admin_password,type=env,target=IDM_ADMIN_PASSWORD
Volume=/srv/quadlet/opencloud:/etc/opencloud:Z
Volume=opencloud-data.volume:/var/lib/opencloud
Volume=/srv/quadlet/opencloud/apps:/var/lib/opencloud/web/assets/apps:Z

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
